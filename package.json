{
  "name": "latch",
  "version": "0.1.0",
  "private": true,
  "description": "Merge-gate triage for a red CI run: cluster the failures, let TypeSafe Jev label the cause, and return Gate: PASS (infra noise) or Gate: BLOCK (a real failure). Works with Playwright, Jest and pytest.",
  "keywords": [
    "playwright",
    "playwright-reporter",
    "jest",
    "pytest",
    "junit",
    "flaky-tests",
    "flaky-test-detection",
    "ci",
    "ci-cd",
    "merge-gate",
    "test-automation",
    "test-reporting",
    "github-actions",
    "jev",
    "typesafe",
    "typesafe-ai",
    "ai"
  ],
  "homepage": "https://github.com/CaseReed/latch#readme",
  "bugs": {
    "url": "https://github.com/CaseReed/latch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaseReed/latch.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:unit": "tsx --test src/attempt.test.ts src/cluster.test.ts src/policy.test.ts src/github.test.ts src/redact.test.ts src/reporter.test.ts src/summarize.test.ts src/ledger.test.ts src/score-run.test.ts src/golden.test.ts src/ingest/junit.test.ts",
    "test:live": "tsx --test src/reporter.live.test.ts",
    "test:e2e": "tsx src/e2e-check.ts",
    "test:stability": "tsx src/stability-check.ts",
    "calibrate": "tsx experiments/calibration/calibrate.ts",
    "demo": "tsx experiments/demo/demo.ts",
    "latch": "tsx src/cli.ts",
    "print:clusters": "tsx src/print-clusters.ts testdata/runs/env-cascade.json"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^18.0.0",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
